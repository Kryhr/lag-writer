# Copy this file to .env and fill in real keys (never commit .env itself).
# You only need ONE key to run the app — add more to spread load across
# independent free-tier quotas. server.py tries them in the order listed
# in PROVIDERS; a provider with no key here is simply skipped, no code
# change needed. Multiple keys per provider are supported too:
# GROQ_API_KEY, GROQ_API_KEY_2, GROQ_API_KEY_3, etc.
#
# Get free keys at:
#   Cerebras:   https://cloud.cerebras.ai
#   Groq:       https://console.groq.com/keys
#   Gemini:     https://aistudio.google.com/apikey
#   OpenRouter: https://openrouter.ai/keys (many ":free"-suffixed models)
#   Together:   https://api.together.ai/settings/api-keys
#   Mistral:    https://console.mistral.ai/api-keys
#   Fireworks:  https://fireworks.ai/account/api-keys
#   DeepInfra:  https://deepinfra.com/dash/api_keys
#   Cohere:     https://dashboard.cohere.com/api-keys
#   GitHub Models: https://github.com/marketplace/models (use a GitHub PAT)
#   Novita:     https://novita.ai/settings/key-management
#   Hyperbolic: https://app.hyperbolic.xyz/settings
#   SambaNova:  https://cloud.sambanova.ai/apis
#   Anthropic (Claude, paid — no free tier): https://console.anthropic.com/settings/keys
#   Perplexity: https://www.perplexity.ai/settings/api
#   xAI (Grok): https://console.x.ai
#   DeepSeek:   https://platform.deepseek.com/api_keys
#   Moonshot (Kimi): https://platform.moonshot.ai/console/api-keys
#   Qwen (DashScope): https://dashscope.console.aliyun.com/apiKey
#   AI21:       https://studio.ai21.com/account/api-key
#   Nebius AI Studio: https://studio.nebius.ai/settings/api-keys
#   Scaleway:   https://console.scaleway.com/iam/api-keys
#   Lambda:     https://cloud.lambda.ai/api-keys
#   Featherless: https://featherless.ai/account/api-keys

CEREBRAS_API_KEY=
